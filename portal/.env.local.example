# ---------------------------------------------------------------------------
# Claude SEO Outreach Portal — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Anthropic (required: scan analysis + email drafting) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override. Defaults to a cost-effective Sonnet model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Firecrawl (required: renders + scrapes the target site) ---
FIRECRAWL_API_KEY=fc-...
# Optional: self-hosted Firecrawl base URL. Defaults to the cloud API.
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# --- Local SERP provider (LITE/FULL map-pack position) ---
# Default provider = serper. Set LOCAL_SERP_PROVIDER=dataforseo to use DataForSEO
# for the map-pack lookup as well (PROOF/geo-grid always uses DataForSEO).
LOCAL_SERP_PROVIDER=serper
SERPER_API_KEY=

# --- Google Places (optional but recommended: GBP signals) ---
# Place Details: categories, rating, review count, photos, hours, website.
GOOGLE_PLACES_API_KEY=

# --- DataForSEO (optional: required only for PROOF / geo-grid mode) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Hard ceiling (USD) for a single PROOF scan. Scans estimated above this are
# blocked before any credits are spent.
DATAFORSEO_MAX_COST_USD=1.00

# --- Supabase (storage + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is server-only. Used to persist scans/emails past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP (Nodemailer) for sending the outreach email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From header, e.g. "Studio Radixs <hello@studioradixs.nl>"
SMTP_FROM=Studio Radixs <hello@example.com>
